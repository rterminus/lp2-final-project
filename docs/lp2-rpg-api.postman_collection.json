{
  "info": {
    "name": "LP2 Final Project - RPG Adventure API",
    "description": "Inicie a API com ./mvnw spring-boot:run e execute as requisições em ordem. Em uma aplicação recém-iniciada, Arthur está ativo e tem duas Potion of Health. Se outro aventureiro estiver ativo, use POST /adventurer/select/Arthur e confira o estoque. O reset recria os encontros e preserva o estado do aventureiro.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "1. Consultar aventureiro ativo (Arthur)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/adventurer/status",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "adventurer",
            "status"
          ]
        }
      }
    },
    {
      "name": "2. Reiniciar a aventura",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/adventure/reset",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "adventure",
            "reset"
          ]
        }
      }
    },
    {
      "name": "3. Consultar cenário inicial (Dark Forest)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/adventure/current",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "adventure",
            "current"
          ]
        }
      }
    },
    {
      "name": "4. Escolher esquerda (Goblin Cave)",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/adventure/choose/left",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "adventure",
            "choose",
            "left"
          ]
        }
      }
    },
    {
      "name": "5. Escolher esquerda (Goblin Lair)",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/adventure/choose/left",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "adventure",
            "choose",
            "left"
          ]
        }
      }
    },
    {
      "name": "6. Atacar Lair Goblin",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/combat/attack",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "combat",
            "attack"
          ]
        }
      }
    },
    {
      "name": "7. Usar poção de cura",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/items/use/Potion%20of%20Health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "items",
            "use",
            "Potion%20of%20Health"
          ]
        }
      }
    },
    {
      "name": "8. Consultar inventário",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/inventory",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "inventory"
          ]
        }
      }
    },
    {
      "name": "9. Adicionar Elixir de raridade RARE",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/inventory/add?quantity=1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "inventory",
            "add"
          ],
          "query": [
            {
              "key": "quantity",
              "value": "1"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Elixir\",\n  \"type\": \"CONSUMABLE\",\n  \"rarity\": \"RARE\",\n  \"amount_heal\": 60\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "10. Filtrar inventário por raridade RARE",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/inventory/filter?rarity=RARE",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "inventory",
            "filter"
          ],
          "query": [
            {
              "key": "rarity",
              "value": "RARE"
            }
          ]
        }
      }
    },
    {
      "name": "11. Escolher esquerda em uma folha (HTTP 400 esperado)",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/adventure/choose/left",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "adventure",
            "choose",
            "left"
          ]
        }
      }
    }
  ]
}
